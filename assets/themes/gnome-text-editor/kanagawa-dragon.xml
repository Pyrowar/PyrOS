<?xml version="1.0" encoding="UTF-8"?>
<!--
  Kanagawa Dragon
  A GtkSourceView 5 color scheme based on the Kanagawa Dragon Neovim theme
  by rebelot (https://github.com/rebelot/kanagawa.nvim).

  Install:
    mkdir -p ~/.local/share/gtksourceview-5/styles/
    cp kanagawa-dragon.xml ~/.local/share/gtksourceview-5/styles/
-->
<style-scheme id="kanagawa-dragon" name="Kanagawa Dragon" version="1.0">
  <author>Ported from rebelot/kanagawa.nvim (Dragon variant)</author>
  <description>Dark color scheme inspired by the colors of Katsushika Hokusai's famous painting — Dragon variant, the darkest of the three Kanagawa themes.</description>

  <!-- ── Palette ───────────────────────────────────────────────────── -->
  <!-- Background scale (dragonBlack0–6) -->
  <color name="dragonBlack0"   value="#0d0c0c"/>  <!-- deepest black -->
  <color name="dragonBlack1"   value="#12120f"/>
  <color name="dragonBlack2"   value="#1D1C19"/>
  <color name="dragonBlack3"   value="#181616"/>  <!-- main bg -->
  <color name="dragonBlack4"   value="#282727"/>  <!-- raised surfaces -->
  <color name="dragonBlack5"   value="#393836"/>  <!-- borders, gutter -->
  <color name="dragonBlack6"   value="#625e5a"/>  <!-- whitespace / nontext -->

  <!-- Foreground / neutrals -->
  <color name="dragonWhite"    value="#c5c9c5"/>  <!-- default fg -->
  <color name="dragonGray"     value="#a6a69c"/>  <!-- parameters -->
  <color name="dragonGray2"    value="#9e9b93"/>  <!-- punctuation -->
  <color name="dragonGray3"    value="#7a8382"/>  <!-- special / line numbers -->
  <color name="dragonAsh"      value="#737c73"/>  <!-- comments -->
  <color name="fujiWhite"      value="#DCD7BA"/>  <!-- bright fg (popups) -->

  <!-- Syntax colours -->
  <color name="dragonGreen"    value="#87a987"/>  <!-- alt green -->
  <color name="dragonGreen2"   value="#8a9a7b"/>  <!-- strings -->
  <color name="dragonBlue2"    value="#8ba4b0"/>  <!-- functions -->
  <color name="dragonViolet"   value="#8992a7"/>  <!-- keywords, statements -->
  <color name="dragonTeal"     value="#949fb5"/>  <!-- special1 -->
  <color name="dragonAqua"     value="#8ea4a2"/>  <!-- types -->
  <color name="dragonYellow"   value="#c4b28a"/>  <!-- identifiers -->
  <color name="dragonPink"     value="#a292a3"/>  <!-- numbers -->
  <color name="dragonRed"      value="#c4746e"/>  <!-- operators, preproc, errors -->
  <color name="dragonOrange"   value="#b6927b"/>  <!-- constants -->
  <color name="dragonOrange2"  value="#b98d7b"/>  <!-- alt constants -->
  <color name="katanaGray"     value="#717C7C"/>  <!-- deprecated -->

  <!-- UI accent colours (shared with Wave) -->
  <color name="waveBlue1"      value="#223249"/>  <!-- visual selection bg -->
  <color name="waveBlue2"      value="#2D4F67"/>  <!-- search highlight bg -->

  <!-- Diagnostics -->
  <color name="diagError"      value="#c4746e"/>  <!-- dragonRed -->
  <color name="diagWarn"       value="#c4b28a"/>  <!-- dragonYellow -->
  <color name="diagInfo"       value="#8ba4b0"/>  <!-- dragonBlue2 -->
  <color name="diagHint"       value="#8ea4a2"/>  <!-- dragonAqua -->

  <!-- ── Editor chrome ─────────────────────────────────────────────── -->
  <style name="text"                        foreground="dragonWhite"   background="dragonBlack3"/>
  <style name="selection"                   background="waveBlue1"     foreground="dragonWhite"/>
  <style name="cursor"                      foreground="dragonWhite"/>
  <style name="current-line"                background="dragonBlack4"/>
  <style name="current-line-number"         foreground="dragonWhite"   background="dragonBlack4"  bold="true"/>
  <style name="line-numbers"                foreground="dragonGray3"   background="dragonBlack2"/>
  <style name="right-margin"                foreground="dragonBlack5"  background="dragonBlack5"/>
  <style name="draw-spaces"                 foreground="dragonBlack6"/>
  <style name="bracket-match"               foreground="dragonYellow"  bold="true"  underline="single"/>
  <style name="bracket-mismatch"            foreground="dragonRed"     bold="true"  underline="single"/>
  <style name="search-match"                background="waveBlue2"     foreground="fujiWhite"/>
  <style name="search-shadow"               background="dragonBlack3"/>

  <!-- ── Diff / version control ───────────────────────────────────── -->
  <style name="diff:added-line"             foreground="dragonGreen"/>
  <style name="diff:removed-line"           foreground="dragonRed"/>
  <style name="diff:changed-line"           foreground="dragonYellow"/>
  <style name="diff:special-case"           foreground="dragonAqua"/>
  <style name="diff:location"               foreground="dragonBlue2"   italic="true"/>

  <!-- ── Generic syntax (all languages) ────────────────────────────── -->
  <style name="def:comment"                 foreground="dragonAsh"     italic="true"/>
  <style name="def:shebang"                 foreground="dragonAsh"     bold="true"/>
  <style name="def:doc-comment"             foreground="dragonAsh"     italic="true"/>
  <style name="def:doc-comment-element"     foreground="dragonBlue2"   italic="true"/>
  <style name="def:string"                  foreground="dragonGreen2"/>
  <style name="def:special-char"            foreground="dragonTeal"/>
  <style name="def:special-constant"        foreground="dragonOrange"/>
  <style name="def:floating-point"          foreground="dragonPink"/>
  <style name="def:decimal"                 foreground="dragonPink"/>
  <style name="def:base-n-integer"          foreground="dragonPink"/>
  <style name="def:complex"                 foreground="dragonPink"/>
  <style name="def:number"                  foreground="dragonPink"/>
  <style name="def:keyword"                 foreground="dragonViolet"  bold="true"/>
  <style name="def:builtin"                 foreground="dragonAqua"/>
  <style name="def:function"                foreground="dragonBlue2"/>
  <style name="def:identifier"              foreground="dragonYellow"/>
  <style name="def:type"                    foreground="dragonAqua"/>
  <style name="def:constant"                foreground="dragonOrange"/>
  <style name="def:boolean"                 foreground="dragonOrange"  bold="true"/>
  <style name="def:null-value"              foreground="dragonOrange"  bold="true"/>
  <style name="def:preprocessor"            foreground="dragonRed"/>
  <style name="def:operator"                foreground="dragonRed"/>
  <style name="def:error"                   foreground="diagError"     underline="error"/>
  <style name="def:warning"                 foreground="diagWarn"      underline="single"/>
  <style name="def:note"                    foreground="diagInfo"      bold="true"/>
  <style name="def:underlined"              underline="single"/>
  <style name="def:net-address"             foreground="dragonTeal"    underline="single"/>
  <style name="def:deprecated"              foreground="katanaGray"    strikethrough="true"/>
  <style name="def:heading"                 foreground="dragonViolet"  bold="true"/>
  <style name="def:heading0"                foreground="dragonViolet"  bold="true"/>
  <style name="def:heading1"                foreground="dragonViolet"  bold="true"/>
  <style name="def:heading2"                foreground="dragonBlue2"   bold="true"/>
  <style name="def:heading3"                foreground="dragonBlue2"/>
  <style name="def:heading4"                foreground="dragonAqua"    bold="true"/>
  <style name="def:heading5"                foreground="dragonAqua"/>
  <style name="def:heading6"                foreground="dragonGreen2"/>

  <!-- ── C / C++ ───────────────────────────────────────────────────── -->
  <style name="c:preprocessor"              foreground="dragonRed"/>
  <style name="c:included-file"             foreground="dragonGreen2"/>
  <style name="c:common-defines"            foreground="dragonOrange"  bold="true"/>

  <!-- ── Python ────────────────────────────────────────────────────── -->
  <style name="python:string-conversion"    foreground="dragonTeal"/>
  <style name="python:decorator"            foreground="dragonYellow"/>
  <style name="python:builtin-function"     foreground="dragonAqua"/>
  <style name="python:builtin-constant"     foreground="dragonOrange"  bold="true"/>
  <style name="python:module-handler"       foreground="dragonViolet"  bold="true"/>
  <style name="python:special-variable"     foreground="dragonAqua"    italic="true"/>

  <!-- ── JavaScript / TypeScript ───────────────────────────────────── -->
  <style name="js:template-literal"         foreground="dragonGreen2"/>
  <style name="js:regex"                    foreground="dragonRed"/>

  <!-- ── HTML / XML ────────────────────────────────────────────────── -->
  <style name="xml:element-name"            foreground="dragonViolet"  bold="true"/>
  <style name="xml:attribute-name"          foreground="dragonBlue2"/>
  <style name="xml:attribute-value"         foreground="dragonGreen2"/>
  <style name="xml:namespace"               foreground="dragonAqua"    italic="true"/>
  <style name="xml:tag"                     foreground="dragonGray2"/>
  <style name="xml:comment"                 foreground="dragonAsh"     italic="true"/>
  <style name="xml:cdata-delim"             foreground="dragonGray3"   bold="true"/>
  <style name="xml:processing-instruction"  foreground="dragonRed"/>
  <style name="xml:doctype"                 foreground="dragonRed"     bold="true"/>
  <style name="xml:entity"                  foreground="dragonTeal"/>

  <!-- ── CSS ───────────────────────────────────────────────────────── -->
  <style name="css:selector-symbol"         foreground="dragonRed"     bold="true"/>
  <style name="css:id-selector"             foreground="dragonYellow"  bold="true"/>
  <style name="css:class-selector"          foreground="dragonYellow"/>
  <style name="css:pseudo-selector"         foreground="dragonAqua"    italic="true"/>
  <style name="css:property-name"           foreground="dragonBlue2"/>
  <style name="css:property-value"          foreground="dragonWhite"/>
  <style name="css:color"                   foreground="dragonOrange"/>
  <style name="css:unit"                    foreground="dragonPink"/>
  <style name="css:at-rule"                 foreground="dragonRed"/>
  <style name="css:vendor-specific"         foreground="dragonGray"    italic="true"/>

  <!-- ── Shell ─────────────────────────────────────────────────────── -->
  <style name="sh:variable"                 foreground="dragonYellow"/>
  <style name="sh:variable-definition"      foreground="dragonBlue2"/>
  <style name="sh:subshell"                 foreground="dragonTeal"/>
  <style name="sh:here-doc-bound"           foreground="dragonViolet"  bold="true"/>
  <style name="sh:here-doc"                 foreground="dragonGreen2"/>

  <!-- ── Markdown ──────────────────────────────────────────────────── -->
  <style name="markdown:emphasis"           italic="true"/>
  <style name="markdown:strong-emphasis"    bold="true"/>
  <style name="markdown:header"             foreground="dragonViolet"  bold="true"/>
  <style name="markdown:thematic-break"     foreground="dragonGray3"/>
  <style name="markdown:code"               foreground="dragonGreen2"/>
  <style name="markdown:code-block"         foreground="dragonGreen2"/>
  <style name="markdown:blockquote-marker"  foreground="dragonAsh"/>
  <style name="markdown:list-marker"        foreground="dragonYellow"  bold="true"/>
  <style name="markdown:link-text"          foreground="dragonBlue2"/>
  <style name="markdown:label"              foreground="dragonAqua"/>
  <style name="markdown:url"                foreground="dragonTeal"    underline="single"/>
  <style name="markdown:image-marker"       foreground="dragonOrange"/>

  <!-- ── Rust ──────────────────────────────────────────────────────── -->
  <style name="rust:lifetime"               foreground="dragonYellow"  italic="true"/>
  <style name="rust:macro"                  foreground="dragonAqua"/>
  <style name="rust:attribute"              foreground="dragonRed"/>
  <style name="rust:scope"                  foreground="dragonAqua"/>

  <!-- ── Go ────────────────────────────────────────────────────────── -->
  <style name="go:printf"                   foreground="dragonTeal"/>

  <!-- ── Ruby ──────────────────────────────────────────────────────── -->
  <style name="ruby:symbol"                 foreground="dragonAqua"/>
  <style name="ruby:regex"                  foreground="dragonRed"/>
  <style name="ruby:instance-variable"      foreground="dragonYellow"/>
  <style name="ruby:class-variable"         foreground="dragonYellow"  bold="true"/>
  <style name="ruby:global-variable"        foreground="dragonOrange2"/>

  <!-- ── Java / Kotlin ─────────────────────────────────────────────── -->
  <style name="java:declaration"            foreground="dragonAqua"    bold="true"/>

  <!-- ── TOML / INI / config ───────────────────────────────────────── -->
  <style name="toml:key"                    foreground="dragonBlue2"/>
  <style name="toml:table"                  foreground="dragonViolet"  bold="true"/>
  <style name="ini:group"                   foreground="dragonViolet"  bold="true"/>
  <style name="ini:key"                     foreground="dragonBlue2"/>

  <!-- ── Log files ─────────────────────────────────────────────────── -->
  <style name="log-text:message"            foreground="dragonWhite"/>
  <style name="log-text:timestamp"          foreground="dragonGray3"/>
  <style name="log-text:warning"            foreground="diagWarn"/>
  <style name="log-text:error"              foreground="diagError"/>
</style-scheme>
